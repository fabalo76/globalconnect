<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Android 11+ package visibility: without this block, queryBroadcastReceivers()
        returns nothing and UIC Home is never found regardless of which flavor is installed.
        Declaring the intent action here makes the package manager visible to any app
        (banpais, uic, or future flavors) that registers a receiver for this action.
    -->
    <queries>
        <intent>
            <action android:name="com.uic.home.ACTION_REQUEST_PARAMS" />
        </intent>
        <intent>
            <action android:name="com.uic.home.ACTION_REPORT_TRANSACTION" />
        </intent>
        <intent>
            <action android:name="com.uic.home.ACTION_REPORT_ADMIN_REQUEST" />
        </intent>
        <intent>
            <action android:name="com.uic.home.ACTION_FORCE_SETTLEMENT" />
        </intent>
        <!-- Needed to discover UIC Home when sending PRE_INSTALL_RESPONSE -->
        <intent>
            <action android:name="com.uic.home.ACTION_PRE_INSTALL_CHECK" />
        </intent>
    </queries>

    <application
        android:name=".UICApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.UICPaymentApp"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="locale"
            android:theme="@style/Theme.UICPaymentApp.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <action android:name="android.intent.action.PAY_APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".cardreader.nexgo.PixiePinEntryActivity"
            android:exported="false"
            android:theme="@style/Theme.UICPaymentApp" />
<!--        <receiver android:enabled="true" android:name=".BootUpReceiver"-->
<!--            android:exported="true"-->
<!--            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">-->
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.BOOT_COMPLETED" />-->
<!--                <category android:name="android.intent.category.DEFAULT" />-->
<!--            </intent-filter>-->
<!--        </receiver>-->

        <!--
            Receives TMS parameter download results from the UIC Home application.
            exported=true so UIC Home (a different process) can send the reply broadcast.
            UIC Home targets this receiver explicitly via `package` = this app's package name.

            Two scenarios:
              Pull — this app requests params on first install (UICApplication.requestParamsFromUicHome)
              Push — UIC Home receives a TMS server MQTT notification and delivers updated params
        -->
        <receiver
            android:name=".TmsParamsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.uic.home.ACTION_PARAMS_READY" />
                <action android:name="com.uic.home.ACTION_PARAMS_FAILED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".transactions.TransactionReportAckReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.uic.home.ACTION_TRANSACTION_REPORT_ACK" />
                <action android:name="com.uic.home.ACTION_TRANSACTION_REPORT_FAILED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".admin.AdminRequestAckReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.uic.home.ACTION_ADMIN_REQUEST_ACK" />
                <action android:name="com.uic.home.ACTION_ADMIN_REQUEST_FAILED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".settlement.ForceSettlementReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.uic.home.ACTION_FORCE_SETTLEMENT" />
            </intent-filter>
        </receiver>

        <!--
            Receives pre-install consent checks from UIC Home before it installs an APK update.
            Responds with ACTION_PRE_INSTALL_RESPONSE (proceed or postpone).
        -->
        <receiver
            android:name=".TmsAppUpdateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.uic.home.ACTION_PRE_INSTALL_CHECK" />
                <action android:name="com.uic.home.ACTION_PRE_INSTALL_DISMISS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
