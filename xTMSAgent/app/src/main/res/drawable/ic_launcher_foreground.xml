<?xml version="1.0" encoding="utf-8"?>
<!--
  House icon for xTMSAgent launcher.
  evenOdd fill creates real transparent holes for door and windows —
  works correctly in both colored and Material You monochrome modes.

  Safe zone: 18–90 on 108×108 viewport.
  Roof peak: (54, 22)  Eaves: (16, 52) / (92, 52)
  Walls: x 24–84, y 52–88
  Left window: (30,56)–(44,72)   Right window: (64,56)–(78,72)
  Door: (45,67)–(63,88)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- House body + roof, with door and window holes via evenOdd -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M54,22 L16,52 L24,52 L24,88 L84,88 L84,52 L92,52 Z
            M30,56 L44,56 L44,72 L30,72 Z
            M64,56 L78,56 L78,72 L64,72 Z
            M45,67 L63,67 L63,88 L45,88 Z" />

    <!-- Subtle drop shadow under eave to add depth -->
    <path
        android:fillColor="#22000000"
        android:pathData="M16,52 L92,52 L84,58 L24,58 Z" />

</vector>
