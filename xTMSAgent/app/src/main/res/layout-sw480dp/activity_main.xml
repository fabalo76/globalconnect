<?xml version="1.0" encoding="utf-8"?>
<!-- N62 (480dp SW): trailer/Global Connect logo moved into top-right corner of top banner.
     Bottom banner hidden — full height goes to the button grid. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Top banner: brand logo left, Global Connect trailer logo right -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recyclerView_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="@string/banner_top_ratio"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <ImageView
            android:id="@+id/imgBrandLogo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingTop="@dimen/banner_img_padding_v"
            android:paddingBottom="@dimen/banner_img_padding_v"
            android:paddingLeft="@dimen/banner_img_padding_h"
            android:paddingRight="4dp"
            android:scaleType="fitCenter"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/imgTrailerLogo"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="@integer/banner_brand_weight" />

        <ImageView
            android:id="@+id/imgTrailerLogo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingTop="@dimen/banner_img_padding_v"
            android:paddingBottom="@dimen/banner_img_padding_v"
            android:paddingLeft="4dp"
            android:paddingRight="@dimen/banner_img_padding_h"
            android:scaleType="fitCenter"
            android:onClick="BtnClick"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/imgBrandLogo"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintHorizontal_weight="@integer/banner_trailer_weight" />

        <TextView
            android:id="@+id/txtBrandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="@dimen/brand_name_text_size"
            android:textColor="@color/white"
            android:layout_marginTop="25dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            tools:textColor="@color/black"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom banner kept gone so UpdateBgClr() findViewById does not crash -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recyclerView_logo_t"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <LinearLayout
        android:id="@+id/dotsIndicator"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tmsNotifStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/dotsIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerFuncs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/recyclerView_logo"
        app:layout_constraintBottom_toTopOf="@+id/dotsIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
