<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#B71C1C"
    android:padding="@dimen/blocked_padding">

    <ImageView
        android:layout_width="@dimen/blocked_icon_size"
        android:layout_height="@dimen/blocked_icon_size"
        android:src="@drawable/ic_blocked"
        android:contentDescription="@null"
        android:layout_marginBottom="@dimen/blocked_icon_margin_bottom" />

    <TextView
        android:id="@+id/tv_block_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/blocked_msg_text_size"
        android:textColor="@android:color/white"
        android:textAlignment="center"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/tv_serial_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/blocked_serial_margin_top"
        android:textSize="@dimen/blocked_serial_text_size"
        android:textColor="#CCFFFFFF"
        android:textAlignment="center"
        android:gravity="center"
        android:fontFamily="monospace" />

    <Button
        android:id="@+id/btnUnlockByCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/unlock_by_code"
        android:visibility="gone" />

</LinearLayout>
